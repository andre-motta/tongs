FROM registry.fedoraproject.org/fedora@sha256:f59ce614aba37211165e711d732fd4785f1c0329c4a3a4289cf29e333cf36c52 AS fetch

COPY builder-rpms.nevra builder-rpms.sha256 /tmp/

# The only networked step: download the exact committed NEVRAs, then reject any
# missing, extra or changed package byte before anything leaves this stage.
RUN mkdir /tmp/builder-rpms \
    && awk '{ print $1 "-" $2 "." $3 }' /tmp/builder-rpms.nevra \
        > /tmp/builder-rpms.specs \
    && xargs --arg-file=/tmp/builder-rpms.specs \
        dnf download --destdir=/tmp/builder-rpms \
    && cd /tmp/builder-rpms \
    && sha256sum --check --strict /tmp/builder-rpms.sha256 \
    && ls -1 | LC_ALL=C sort > /tmp/builder-rpms.present \
    && awk '{ print $2 }' /tmp/builder-rpms.sha256 | LC_ALL=C sort \
        > /tmp/builder-rpms.expected \
    && test "$(cat /tmp/builder-rpms.expected)" = "$(cat /tmp/builder-rpms.present)"

FROM registry.fedoraproject.org/fedora@sha256:f59ce614aba37211165e711d732fd4785f1c0329c4a3a4289cf29e333cf36c52

COPY builder-rpms.nevra builder-rpms.sha256 /tmp/
COPY --from=fetch /tmp/builder-rpms /tmp/builder-rpms

# Offline install: every repository is disabled, so the committed closure is
# the complete package input and no live Fedora repository is consulted.
RUN mkdir /usr/share/tongs-archive-builder \
    && cd /tmp/builder-rpms \
    && sha256sum --check --strict /tmp/builder-rpms.sha256 \
        > /usr/share/tongs-archive-builder/rpm-sha256-check.txt \
    && cat /usr/share/tongs-archive-builder/rpm-sha256-check.txt \
    && rpmkeys --checksig --verbose ./*.rpm \
        > /usr/share/tongs-archive-builder/rpm-signatures.txt \
    && cat /usr/share/tongs-archive-builder/rpm-signatures.txt \
    && rpm --query --package \
        --queryformat '%{NAME} %{EPOCHNUM}:%{VERSION}-%{RELEASE} %{ARCH}\n' \
        ./*.rpm > /tmp/rpm-nevra.unsorted \
    && LC_ALL=C sort /tmp/rpm-nevra.unsorted \
        > /usr/share/tongs-archive-builder/rpm-nevra.txt \
    && test "$(cat /tmp/builder-rpms.nevra)" \
        = "$(cat /usr/share/tongs-archive-builder/rpm-nevra.txt)" \
    && dnf install --assumeyes --disablerepo='*' \
        --setopt=install_weak_deps=False \
        --setopt=localpkg_gpgcheck=True ./*.rpm \
    && rpm --query --all \
        --queryformat '%{NAME} %{EPOCHNUM}:%{VERSION}-%{RELEASE} %{ARCH}\n' \
        | LC_ALL=C sort > /usr/share/tongs-archive-builder/rpm-qa.txt \
    && LC_ALL=C comm -23 /tmp/builder-rpms.nevra \
        /usr/share/tongs-archive-builder/rpm-qa.txt > /tmp/rpm-missing.txt \
    && test ! -s /tmp/rpm-missing.txt \
    && dnf clean all \
    && rm -rf /tmp/builder-rpms /tmp/builder-rpms.nevra /tmp/builder-rpms.sha256 \
        /tmp/rpm-nevra.unsorted /tmp/rpm-missing.txt /var/cache/dnf

RUN test "$(python3.12 -c 'import platform; print(platform.python_version())')" = '3.12.14' \
    && test "$(python3.12 -c 'import zlib; print(zlib.ZLIB_VERSION)')" = '1.3.1.zlib-ng' \
    && test "$(python3.12 -c 'import zlib; print(zlib.ZLIB_RUNTIME_VERSION)')" = '1.3.1.zlib-ng' \
    && test "$(node --version)" = 'v22.23.1' \
    && test "$(npm --version)" = '10.9.8'

ENV LC_ALL=C.UTF-8
ENV TZ=UTC
