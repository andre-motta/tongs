{
  "name": "tongs-desktop-shell",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/src/main/index.js",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "clean": "node scripts/build.mjs --clean",
    "build": "node scripts/build.mjs --prepare && tsc -p tsconfig.json && node scripts/build.mjs",
    "test": "npm run build && node --test ../tests/desktop/electron/*.test.mjs ../tests/desktop/renderer/*.test.mjs",
    "start": "npm run build && electron ."
  },
  "devDependencies": {
    "@electron/asar": "4.3.0",
    "@testing-library/react": "16.3.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.7",
    "electron": "44.2.0",
    "esbuild": "0.28.2",
    "jsdom": "27.0.0",
    "typescript": "7.0.2"
  },
  "dependencies": {
    "react": "19.2.8",
    "react-dom": "19.2.8"
  }
}
