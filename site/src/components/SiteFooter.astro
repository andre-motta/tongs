---
import { footerColumns, site } from '../data/nav.mjs';
---

<footer class="site-footer">
  <div class="wrap">
    <div class="brandcol">
      <span class="wordmark" translate="no">tongs</span>
      <p class="fine">Unified code review for the terminal. A review inbox for GitHub and GitLab. MIT licensed. No tracking, no analytics.</p>
    </div>
    {
      footerColumns.map((col) => (
        <div>
          <h2>{col.title}</h2>
          <ul>
            {col.links.map((l) => (
              <li>
                <a href={l.href}>{l.label}</a>
              </li>
            ))}
          </ul>
        </div>
      ))
    }
    <div class="base">
      <span>made by <a href={site.author.url} rel="author">{site.author.name}</a></span>
      <span>{site.version}, released {site.released}</span>
    </div>
    <div class="notes">
      <p class="fine credits">Trailer music: <cite>With These Hands</cite> by Scott Buckley (<a href="https://www.scottbuckley.com.au/library/with-these-hands/">scottbuckley.com.au</a>), released under <a href="https://creativecommons.org/licenses/by/4.0/" rel="license">CC BY 4.0</a>.</p>
      <p class="fine trademarks">GitHub is a trademark of GitHub, Inc. GITLAB is a trademark of GitLab Inc. in the United States and other countries and regions. tongs is an independent project, not affiliated with or endorsed by either.</p>
    </div>
  </div>
</footer>
